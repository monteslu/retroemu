{
  "name": "retroemu",
  "version": "0.6.0",
  "description": "Terminal retro game emulator using libretro WASM cores",
  "type": "module",
  "main": "index.js",
  "bin": {
    "retroemu": "./bin/cli.js",
    "abtool": "./bin/active-bezel.js"
  },
  "files": [
    "bin/",
    "src/",
    "cores/",
    "system/",
    "sdk/",
    "docs/",
    "examples/active-bezel/",
    "index.js"
  ],
  "keywords": [
    "emulator",
    "retro",
    "terminal",
    "libretro",
    "nes",
    "snes",
    "gameboy",
    "genesis",
    "atari",
    "wasm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/monteslu/retroemu.git"
  },
  "author": "Luis Montes",
  "license": "MIT",
  "scripts": {
    "build:cores": "./scripts/build-all-cores.sh",
    "build:core": "./scripts/build-core.sh",
    "build:active-bezel-examples": "node scripts/generate-active-bezel-diagnostic.mjs",
    "benchmark:active-bezel": "node scripts/benchmark-active-bezel.mjs",
    "test": "node --test test/unit/*.test.js",
    "lint": "eslint src/ bin/ index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@kmamal/sdl": "^0.11.13",
    "@monteslu/chafa-wasm": "^0.4.0",
    "active-bezel": "^0.8.0",
    "gamepad-node": "^1.5.0",
    "hsync": "^0.33.0",
    "native-gles": "^0.5.0",
    "node-datachannel": "^0.32.3",
    "romdev-audio-resampler": "^0.1.0",
    "romdev-core-beetle-psx-hw": "^0.2.0",
    "romdev-core-fake08": "^0.1.0",
    "romdev-core-fceumm": "^0.12.0",
    "romdev-core-flycast": "^0.4.0",
    "romdev-core-gambatte": "^0.11.0",
    "romdev-core-gametank": "^0.4.0",
    "romdev-core-gpgx": "^0.14.0",
    "romdev-core-handy": "^0.8.0",
    "romdev-core-parallel-n64": "^0.2.0",
    "romdev-core-prosystem": "^0.9.0",
    "romdev-core-vice": "^0.10.0",
    "romdev-platform-atari2600": "^0.9.0",
    "romdev-platform-gba": "^0.11.0",
    "romdev-platform-snes": "^0.10.0",
    "rungame": "^0.14.1",
    "wasmcart": "^0.24.0",
    "webgl-node": "^1.5.1",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "eslint": "^9.38.0"
  }
}
